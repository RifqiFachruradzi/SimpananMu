# Kunci API Google Gemini untuk fitur AI Buddy (jangan commit nilai aslinya).
# Buat gratis di https://aistudio.google.com/apikey
# Lokal: salin ke .env.local. Vercel: Project Settings → Environment Variables.
GEMINI_API_KEY=

# Opsional: model Gemini yang dipakai (default: gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest
