# Salin ke Environment Variables di Vercel (jangan commit nilai aslinya).
# Lokal: salin file ini menjadi .env.local.

# Database: otomatis terisi jika Upstash Redis dihubungkan lewat Vercel → Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AI Buddy: API key Google Gemini (gratis di https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opsional
# GEMINI_MODEL=gemini-flash-latest
# BUDDY_DAILY_LIMIT=30
